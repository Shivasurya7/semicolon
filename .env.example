# Copy to .env and fill in. Never commit .env.
# Keys follow the configuration inventory in docs/Implementation_Plan.md; each phase adds its own.

# --- App (0.1) ---
SPRING_PROFILES_ACTIVE=dev
APP_PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_ENVIRONMENT=local

# --- Database (0.1) ---
DB_URL=jdbc:mysql://localhost:3306/semicolan_mvp?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useAffectedRows=true
DB_USER=root
DB_PASSWORD=root

# --- Frontend, build time (1.2) ---
# Vite reads this file from the repo root (frontend/vite.config.ts envDir). Only VITE_* keys reach the bundle.
VITE_WARMUP_PROBLEM_SLUG=two-sum
VITE_SUPPORT_EMAIL=support@semicolan.example
